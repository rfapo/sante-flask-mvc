# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development

# Security - REQUIRED in production
# Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-change-in-production

# Database Configuration
DATABASE_URL=sqlite:///sante.db

# Root Admin Configuration
ROOT_ADMIN_EMAIL=your-admin@example.com

# OpenAI Configuration (for report generation)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Mapbox Configuration (for Kepler.gl maps)
# Get your token at: https://account.mapbox.com/access-tokens/
MAPBOX_TOKEN=your_mapbox_token_here
